# =============================================================================
# CloudPlatform Admin Panel — Environment Configuration
# =============================================================================
# 复制此文件为 .env 并填入真实值
# =============================================================================

# ---------------------------------------------------------------------------
# 应用基础配置
# ---------------------------------------------------------------------------
APP_NAME=CloudPlatform
APP_DEBUG=false                  # 生产环境必须为 false
APP_TIMEZONE=UTC                 # 可选值：UTC, Asia/Shanghai, Asia/Tokyo 等

# ---------------------------------------------------------------------------
# 管理员数据库（MySQL）— cloud_wa_* 系统表 + cloud_* 业务表
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cloud
DB_USERNAME=app_user
DB_PASSWORD=
DB_PREFIX=cloud_

# ---------------------------------------------------------------------------
# Redis（缓存、会话、队列）
# ---------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX=cloud:

# ---------------------------------------------------------------------------
# Hashids — API 响应 ID 混淆
# ---------------------------------------------------------------------------
# 盐值必须与 service 端一致才能正确编解码 hashid
HASHIDS_SALT=<your-random-salt>  # 必须与 service 端一致，各环境不可共享
HASHIDS_LENGTH=12                # 最小输出长度

# ---------------------------------------------------------------------------
# Snowflake — 分布式主键 ID 生成
# ---------------------------------------------------------------------------
SNOWFLAKE_WORKER_ID=0            # 工作机器 ID（0-31），多机部署时每台唯一
SNOWFLAKE_DATACENTER_ID=0        # 数据中心 ID（0-31）
SNOWFLAKE_EPOCH=1704067200000    # 起始时间戳（毫秒），一般设为项目上线日期

# ---------------------------------------------------------------------------
# 数据库字段加密 — 模型敏感字段 AES-128-ECB
# ---------------------------------------------------------------------------
# 生成方式：echo -n "$(openssl rand -base64 16)" | base64 -w0
ENCRYPTION_KEY=<base64-encoded-16-byte-key>
ENCRYPTION_CIPHER=aes-128-ecb    # ECB=确定性加密（相同明文→相同密文，可查询）

# ---------------------------------------------------------------------------
# Elasticsearch — 全文搜索与数据同步（erikwang2013/webman-scout）
# ---------------------------------------------------------------------------
ELASTICSEARCH_HOSTS=http://127.0.0.1:9200
ELASTICSEARCH_USERNAME=          # ES 基本认证（可选）
ELASTICSEARCH_PASSWORD=          # ES 基本认证（可选）
ELASTICSEARCH_SSL_VERIFICATION=false  # 生产环境建议 true
SCOUT_PREFIX=                    # 索引名前缀（可选，如 cloud_）

# ---------------------------------------------------------------------------
# 传输加密 — API 请求/响应体 AES-256-GCM
# ---------------------------------------------------------------------------
# 生成方式：openssl rand -base64 32
ENCRYPTION_MASTER_KEY=<base64-encoded-32-byte-key>

# =============================================================================
# 重要提示
# =============================================================================
# 以下配置项必须与 service/.env 保持一致，否则管理后台将无法正确解密数据：
#   - HASHIDS_SALT（ID 混淆盐值）
#   - ENCRYPTION_KEY（字段加密密钥）
#   - ENCRYPTION_MASTER_KEY（传输加密主密钥）
#   - SNOWFLAKE_WORKER_ID / SNOWFLAKE_DATACENTER_ID / SNOWFLAKE_EPOCH
#
# Security Plugin 配置文件位于：
#   config/plugin/erikwang2013/security-php/app.php
# 31 种攻击检测器独立可配置（启用/禁用 + 拦截/日志模式）
# =============================================================================
