{
    "name": "cloud/platform",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "workerman/webman-framework": "^2.1",
        "webman/admin": "^2.1",
        "illuminate/database": "^10.0",
        "illuminate/events": "^10.0",
        "erikwang2013/jwt-webman": "^2.0",
        "erikwang2013/hashids": "^1.0",
        "erikwang2013/encryption": "^1.0",
        "erikwang2013/encryptable": "^2.0",
        "erikwang2013/webman-scout": "^2.0",
        "erikwang2013/season": "^2.0",
        "vlucas/phpdotenv": "^5.0",
        "monolog/monolog": "^3.0",
        "webman/redis-queue": "^1.0",
        "illuminate/redis": "^10.0",
        "guzzlehttp/guzzle": "^7.0",
        "erikwang2013/snowflake-php": "^2.0",
        "phpoffice/phpspreadsheet": "^2.0",
        "stripe/stripe-php": "^15.0",
        "twilio/sdk": "^8.0",
        "kreait/firebase-php": "^7.0",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-redis": "*",
        "erikwang2013/poster-php": "^1.0",
        "hg/apidoc": "^5.3",
        "erikwang2013/security-php": "^1.1",
        "aws/aws-sdk-php": "^3.300",
        "webonyx/graphql-php": "^15.0",
        "symfony/mailer": "^6.4",
        "dompdf/dompdf": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Common\\": "common/",
            "support\\": "support/",
            "Ecat\\": "app/Grpc/Generated/Ecat/",
            "GPBMetadata\\": "app/Grpc/Generated/GPBMetadata/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "erikwang2013/encryptable": true,
            "erikwang2013/webman-scout": true,
            "erikwang2013/security-php": true
        }
    }
}
