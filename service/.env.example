# =============================================================================
# CloudPlatform — Environment Configuration
# =============================================================================
# 复制此文件为 .env 并填入真实值
# 生成方式参考下方注释中的 openssl 命令
# =============================================================================

# ---------------------------------------------------------------------------
# 应用基础配置
# ---------------------------------------------------------------------------
APP_NAME=CloudPlatform
APP_DEBUG=false                  # 生产环境必须为 false
APP_TIMEZONE=UTC                 # 可选值：UTC, Asia/Shanghai, Asia/Tokyo 等

# ---------------------------------------------------------------------------
# 主业务数据库（MySQL）
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cloud_platform
DB_USERNAME=app_user
DB_PASSWORD=

# ---------------------------------------------------------------------------
# 审计数据库（独立部署，满足合规和安全审计要求）
# ---------------------------------------------------------------------------
AUDIT_DB_HOST=127.0.0.1
AUDIT_DB_PORT=3306
AUDIT_DB_DATABASE=cloud_platform_audit
AUDIT_DB_USERNAME=app_user
AUDIT_DB_PASSWORD=

# ---------------------------------------------------------------------------
# Redis（3 个逻辑库：db0=通用, db1=缓存, db2=会话）
# ---------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# Hashids — API 响应 ID 混淆
# ---------------------------------------------------------------------------
HASHIDS_SALT=<your-random-salt>       # 必须生成唯一随机值，各环境不可共享
HASHIDS_LENGTH=12                          # 最小输出长度

# ---------------------------------------------------------------------------
# Snowflake — 分布式主键 ID 生成
# ---------------------------------------------------------------------------
SNOWFLAKE_WORKER_ID=0                     # 工作机器 ID（0-31），多机部署时每台唯一
SNOWFLAKE_DATACENTER_ID=0                 # 数据中心 ID（0-31）
SNOWFLAKE_EPOCH=1704067200000             # 起始时间戳（毫秒），一般设为项目上线日期

# ---------------------------------------------------------------------------
# JWT — 身份认证令牌（erikwang2013/jwt-webman）
# ---------------------------------------------------------------------------
# 生成方式：openssl rand -base64 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256                       # 签名算法，HS256 = HMAC-SHA256
JWT_ISSUER=cloud-platform                  # 签发者标识
JWT_AUDIENCE=                              # 接收者标识（可选）
JWT_ACCESS_TTL=900                         # Access Token 有效期（秒），默认 15 分钟
JWT_REFRESH_TTL=2592000                    # Refresh Token 有效期（秒），默认 30 天
JWT_STORAGE_TYPE=redis                     # 黑名单存储：redis 或 file
JWT_STORAGE_PREFIX=jwt_blacklist:          # 黑名单 Redis key 前缀
JWT_STORAGE_DATABASE=0                     # 黑名单 Redis 数据库编号

# ---------------------------------------------------------------------------
# CORS 跨域白名单
#
# 允许的跨域来源，逗号分隔。支持通配符子域名 *.example.com
# 生产环境必须显式列出允许的域名，不可使用 *
CORS_ALLOWED_ORIGINS=https://example.com,https://admin.example.com

# 传输加密 — API 请求/响应体 AES-256-GCM（erikwang2013/encryption）
# ---------------------------------------------------------------------------
# 生成方式：openssl rand -base64 32
ENCRYPTION_MASTER_KEY=<base64-encoded-32-byte-key>

# ---------------------------------------------------------------------------
# 数据库字段加密 — 模型敏感字段 AES-128-ECB（erikwang2013/encryptable）
# ---------------------------------------------------------------------------
# 生成方式：echo -n "$(openssl rand -base64 16)" | base64 -w0
ENCRYPTION_KEY=<base64-encoded-16-byte-key>
ENCRYPTION_CIPHER=aes-128-ecb             # ECB=确定性加密（相同明文→相同密文，可查询）
# 密钥轮换用：旧密钥逗号分隔，解密时依次尝试，重加密写回主密钥
ENCRYPTION_PREVIOUS_KEYS=

# ---------------------------------------------------------------------------
# 邮件服务（SMTP）
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587                              # 587=TLS, 465=SSL, 25=明文
SMTP_USERNAME=apikey
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls                        # tls 或 ssl
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=CloudPlatform

# ---------------------------------------------------------------------------
# 支付网关 — Stripe
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=                         # Stripe Secret Key（sk_live_xxx 或 sk_test_xxx）
STRIPE_WEBHOOK_SECRET=                     # Webhook 签名密钥（whsec_xxx）

# ---------------------------------------------------------------------------
# Elasticsearch — 全文搜索与数据同步（erikwang2013/webman-scout）
# ---------------------------------------------------------------------------
# 单节点：http://127.0.0.1:9200  |  集群：http://es1:9200,http://es2:9200
ELASTICSEARCH_HOSTS=http://127.0.0.1:9200
ELASTICSEARCH_USERNAME=                     # ES 基本认证（可选）
ELASTICSEARCH_PASSWORD=                     # ES 基本认证（可选）
ELASTICSEARCH_SSL_VERIFICATION=false        # 生产环境建议 true
SCOUT_PREFIX=                               # 索引名前缀（可选，如 cloud_platform_）

# ---------------------------------------------------------------------------
# 短信网关 — Twilio
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---------------------------------------------------------------------------
# 推送通知 — Firebase Cloud Messaging (kreait/firebase-php)
# ---------------------------------------------------------------------------
FIREBASE_CREDENTIALS_PATH=/path/to/firebase-service-account.json

# ---------------------------------------------------------------------------
# 点击验证码 — erikwang2013/poster-php
# ---------------------------------------------------------------------------
# 用于登录、注册等敏感操作的图形验证码（点击图中文字验证）
CAPTCHA_STORAGE=auto                 # 存储驱动：auto=自动检测, redis=Redis集群, file=文件, session=会话
CAPTCHA_TTL=300                      # 验证码有效期（秒），超时后 key 作废
CAPTCHA_MAX_ATTEMPTS=3               # 同一 key 最多尝试验证次数，超过则作废（防暴力枚举坐标）
CAPTCHA_DIFFICULTY=medium            # 默认难度：easy=2个目标, medium=3个, hard=4个
CAPTCHA_REDIS_PREFIX=poster:captcha: # Redis key 前缀（storage=redis 时生效）

# ---------------------------------------------------------------------------
# Sentry 异常监控
# ---------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_RATE=0.1
SENTRY_PROFILES_RATE=0.05

# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# 安全响应头
# ---------------------------------------------------------------------------
# HSTS 启用，仅在 HTTPS 环境下开启（设为 true 启用）
SECURITY_HSTS_ENABLE=false
# HSTS 值（可选，默认：max-age=31536000; includeSubDomains）
#SECURITY_HSTS_VALUE=max-age=31536000; includeSubDomains
# X-Frame-Options 值（默认：SAMEORIGIN，可选：DENY）
SECURITY_X_FRAME_OPTIONS=SAMEORIGIN

# ---------------------------------------------------------------------------
# 地理封禁（GeoIP2）
# ---------------------------------------------------------------------------
# 封禁的国家/地区代码（ISO 3166-1 alpha-2，逗号分隔）
# 示例：GEO_BLOCKED_COUNTRIES=CN,RU,IR,KP
GEO_BLOCKED_COUNTRIES=
# GeoLite2 数据库路径（mmdb 格式）
#GEOIP_DB_PATH=

# Feature Flags 功能开关（可通过管理后台 /admin/api/features 动态覆盖）
# ---------------------------------------------------------------------------
FEATURE_SUPPLIER_API=false
FEATURE_WEBSOCKET=false
FEATURE_MAINTENANCE_REDIRECT=false
FEATURE_TOTP=true
FEATURE_GOOGLE_OAUTH=true
FEATURE_APPLE_OAUTH=true
FEATURE_FACEBOOK_OAUTH=true
FEATURE_X_OAUTH=true
FEATURE_MICROSOFT_OAUTH=true
FEATURE_LINKEDIN_OAUTH=true
FEATURE_GITHUB_OAUTH=true
FEATURE_SSL_PRODUCT=true
FEATURE_OBJECT_STORAGE=true
FEATURE_USAGE_BILLING=true
FEATURE_PROMETHEUS=true
FEATURE_CDN_PRODUCT=true
FEATURE_SUPPLIER_RATING=true
FEATURE_AFFILIATE=true
FEATURE_GRAPHQL=true

# ---------------------------------------------------------------------------
# 应用元信息
# ---------------------------------------------------------------------------
APP_ENV=production                # production / staging / development
APP_VERSION=1.0.0
APP_URL=https://example.com       # 供 OAuth 回调拼接、邮件链接等使用

# ---------------------------------------------------------------------------
# OAuth 第三方登录凭据（未填写的提供商自动视为关闭）
# 回调地址：{APP_URL}/api/auth/{provider}/callback
# ---------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_REDIRECT_URI=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=/path/to/AuthKey.p8
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_REDIRECT_URI=
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
X_OAUTH_REDIRECT_URI=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=
LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=
LINKEDIN_OAUTH_REDIRECT_URI=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=

# ---------------------------------------------------------------------------
# 运维与内部接口
# ---------------------------------------------------------------------------
JWT_LEEWAY=60                     # JWT 签发时间容差（秒），多机时钟偏差防护
INTERNAL_MONITOR_TOKEN=           # 内部健康检查/指标接口令牌
MAINTENANCE_MODE=false            # 维护模式开关
MAINTENANCE_ALLOWED_IPS=127.0.0.1 # 维护模式下允许访问的 IP（逗号分隔）
WEBHOOK_SECRET=                   # 外部 Webhook 签名校验密钥

# ---------------------------------------------------------------------------
# 对象存储与备份（S3 兼容）
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=

# ---------------------------------------------------------------------------
# 读写分离 — 只读副本（可选）
# ---------------------------------------------------------------------------
DB_READ_HOST=

# ---------------------------------------------------------------------------
# 服务端口
# ---------------------------------------------------------------------------
METRICS_PORT=9100                 # Prometheus 指标暴露端口
WS_PORT=8888                      # WebSocket 服务端口

# ---------------------------------------------------------------------------
# 可选扩展配置（留空使用默认值）
# ---------------------------------------------------------------------------
GEOIP_DB_PATH=                    # GeoLite2 数据库路径（mmdb 格式，已封禁国家时必填）
SSL_STAGING=false                 # SSL 证书签发是否使用 Let's Encrypt 预演环境
#HASHIDS_ALPHABET=abcdefghijkmnopqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ123456789
#POSTER_IMAGE_DRIVER=imagick      # 点击验证码图片驱动：gd / imagick
#EXCHANGE_RATE_API_URL=
#COUNTRY_SEASON_DEFAULT=
